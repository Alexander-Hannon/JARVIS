# Copy to .env (chmod 600). Placeholders only — never commit real values.

# --- network (defaults are loopback-only) ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Remote/phone profile ONLY behind authenticated HTTPS you control (see DEPLOYMENT.md):
# JARVIS_REMOTE_MODE=true
# JARVIS_PUBLIC_ORIGIN=https://jarvis.your-tailnet.ts.net
# JARVIS_ALLOWED_HOSTS=["127.0.0.1","localhost","jarvis.your-tailnet.ts.net"]

# --- storage ---
# JARVIS_DATA_DIR=/absolute/path/to/private/jarvis-data
# Token-encryption key: default is <data_dir>/secret.key (0600, auto-created). Or supply a Fernet key:
# JARVIS_SECRET_KEY=

# --- local speech-to-text (faster-whisper) ---
JARVIS_STT_MODEL=base.en
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
# GPU profile (NVIDIA + CUDA libs): JARVIS_STT_DEVICE=cuda  JARVIS_STT_COMPUTE_TYPE=float16  JARVIS_STT_MODEL=small.en
# JARVIS_STT_MIN_CONFIDENCE=0.55

# --- reasoning/vision provider (optional; can also be entered in Settings, stored encrypted) ---
# JARVIS_ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODEL_DEFAULT=claude-opus-5-5

# --- Google OAuth web client (Calendar/Drive) ---
# JARVIS_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# JARVIS_GOOGLE_CLIENT_SECRET=

# --- Web Push (generate with: uv run jarvis gen-vapid) ---
# JARVIS_VAPID_PUBLIC_KEY=
# JARVIS_VAPID_PRIVATE_KEY=
# JARVIS_VAPID_SUBJECT=mailto:you@example.com
